# Copy to an ignored environment file and replace every placeholder before use.
VERBOFLEX_APP_ENV=local
VERBOFLEX_DATABASE_URL=postgresql+psycopg://replace-me:replace-me@localhost:5432/verboflex
VERBOFLEX_REDIS_URL=redis://localhost:6379/0
VERBOFLEX_JWT_SECRET_KEY=replace-me-with-at-least-32-random-bytes
VERBOFLEX_JWT_ALGORITHM=HS256
# Enable OAuth MCP on the same public origin as the SPA; HTTPS except loopback.
VERBOFLEX_MCP_PUBLIC_URL=
VERBOFLEX_CORS_ORIGINS=["http://localhost:5173"]
VERBOFLEX_ACCESS_TOKEN_EXPIRE_MINUTES=15
VERBOFLEX_PASSWORD_CHANGE_TOKEN_EXPIRE_MINUTES=5
VERBOFLEX_REFRESH_TOKEN_EXPIRE_DAYS=7
VERBOFLEX_SERVICE_PROBE_TIMEOUT_SECONDS=2
# On-demand Android capture requires a separately provisioned worker and sandbox.
# See docs/code-keys-compose.md; an empty command disables capture acceptance.
VERBOFLEX_SCREENSHOT_RUNNER_COMMAND=[]
VERBOFLEX_SCREENSHOT_TIMEOUT_SECONDS=900
# The refresh cookie is Secure-only in every environment.
VERBOFLEX_REFRESH_COOKIE_SECURE=true
# Daily database upkeep at 03:30 UTC; see docs/database-maintenance.md.
VERBOFLEX_MAINTENANCE_ENABLED=true
VERBOFLEX_MAINTENANCE_TEMPORARY_RETENTION_DAYS=7
# Automatic deleted-product purge is disabled when this variable is absent.
# Explicit opt-in only: VERBOFLEX_MAINTENANCE_DELETED_PRODUCT_RETENTION_DAYS=30
VERBOFLEX_MAINTENANCE_BATCH_ROWS=1000
VERBOFLEX_MAINTENANCE_MAX_ROWS_PER_RUN=10000
VERBOFLEX_MAINTENANCE_MAX_RUN_SECONDS=45
VERBOFLEX_MAINTENANCE_LOCK_TIMEOUT_MS=1000
VERBOFLEX_MAINTENANCE_STATEMENT_TIMEOUT_MS=5000

# Optional docker-compose.backup.yml; see docs/backup-restore.md.
# The private deployment config MUST contain the keyring required by the database.
VERBOFLEX_BACKUP_DIRECTORY=./.env.docker-backups/daily
VERBOFLEX_BACKUP_CONFIG_FILE=./.env.docker
VERBOFLEX_BACKUP_HOUR_UTC=3
VERBOFLEX_BACKUP_KEEP_COUNT=14
VERBOFLEX_BACKUP_COMMAND_TIMEOUT_SECONDS=1800
# Restore cutover: select an explicitly restored NEW database and an empty Redis DB.
VERBOFLEX_POSTGRES_DB=verboflex
VERBOFLEX_REDIS_DB=0
