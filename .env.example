# Copy to an ignored environment file and replace every placeholder before use.
VERBOFLEX_APP_ENV=local
VERBOFLEX_DATABASE_URL=postgresql+psycopg://replace-me:replace-me@localhost:5432/verboflex
VERBOFLEX_REDIS_URL=redis://localhost:6379/0
VERBOFLEX_JWT_SECRET_KEY=replace-me-with-at-least-32-random-bytes
VERBOFLEX_JWT_ALGORITHM=HS256
VERBOFLEX_CORS_ORIGINS=["http://localhost:5173"]
VERBOFLEX_ACCESS_TOKEN_EXPIRE_MINUTES=15
VERBOFLEX_PASSWORD_CHANGE_TOKEN_EXPIRE_MINUTES=5
VERBOFLEX_REFRESH_TOKEN_EXPIRE_DAYS=7
VERBOFLEX_SERVICE_PROBE_TIMEOUT_SECONDS=2
# The refresh cookie is Secure-only in every environment.
VERBOFLEX_REFRESH_COOKIE_SECURE=true
